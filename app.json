{
  "name": "RavenPlanner",
  "description": "Carleton University timetable planner",
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "addons": [
    "heroku-postgresql:essential-0"
  ],
  "env": {
    "NODE_ENV": {
      "value": "production"
    },
    "ACTIVE_TERM": {
      "value": "SUMMER"
    },
    "ACTIVE_YEAR": {
      "value": "2025"
    },
    "PGSSLMODE": {
      "description": "Require encrypted PostgreSQL connections with certificate verification. Supply a trusted database CA if needed.",
      "value": "verify-full"
    }
  }
}
