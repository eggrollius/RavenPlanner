# Optional: npm run dev works without this file. These defaults select the demo catalog.
# DATABASE_URL is used by production/dev:external; dev always uses its own local database.
POSTGRES_PASSWORD=change-me
PORT=5000
VITE_PORT=5173
# Default catalog; the worker refreshes all terms offered by Carleton Central.
ACTIVE_TERM=FALL
ACTIVE_YEAR=2026
RAVEN_API_URL=http://localhost:5000/api
RAVEN_SCRAPE_INTERVAL_SECONDS=86400
RAVEN_BROWSER_WAIT_MS=30000
RAVEN_SCRAPE_LOG_FILE=logs/scrape.jsonl
# Server-hosted GGUF model. Download once; clients never download weights.
RAVEN_ADVISOR_MODEL_PATH=.local/models/smol.gguf
# One active inference process; this caps its native CPU threads.
RAVEN_ADVISOR_THREADS=1
RAVEN_ADVISOR_QUEUE_SIZE=4
# Includes both queue time and inference time.
RAVEN_ADVISOR_TIMEOUT_MS=180000
# Heroku: opt in to bundling the model in the slug during heroku-postbuild.
RAVEN_ADVISOR_DOWNLOAD_ON_BUILD=false
