# Optional: npm run dev works without this file. These defaults select the demo catalog.
# DATABASE_URL is used by production/dev:external; dev always uses its own local database.
POSTGRES_PASSWORD=change-me
PORT=5000
VITE_PORT=5173
# Default catalog; the worker refreshes all terms offered by Carleton Central.
ACTIVE_TERM=FALL
ACTIVE_YEAR=2026
CARLETON_CENTRAL_USERNAME=
CARLETON_CENTRAL_PASSWORD=
RAVEN_API_URL=http://localhost:5000/api
RAVEN_SCRAPE_INTERVAL_SECONDS=86400
RAVEN_BROWSER_WAIT_MS=30000
RAVEN_SCRAPE_LOG_FILE=logs/scrape.jsonl
