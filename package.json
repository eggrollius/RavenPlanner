{
  "name": "raven-planner",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "benchmark:advisor": "node scripts/benchmark-advisor.mjs",
    "dev": "tsx scripts/dev.ts",
    "dev:external": "concurrently --kill-others \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "db:seed": "tsx scripts/dev.ts --seed",
    "db:reset": "tsx scripts/dev.ts --reset",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.worker.json && vite build",
    "start": "node dist/server/index.js",
    "migrate": "node dist/server/migrate.js",
    "scrape": "node dist/RavenData/scrape.js",
    "worker": "node dist/RavenData/worker.js",
    "scrape:dev": "tsx RavenData/scrape.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:containers": "./scripts/test-containers.sh",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.dev.json",
    "validate": "npm run lint && npm run typecheck && npm test && npm run build",
    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "@wllama/wllama": "^3.8.1",
    "cheerio": "^1.2.0",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "selenium-webdriver": "^4.51.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@electric-sql/pglite-socket": "^0.2.16",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/selenium-webdriver": "^4.35.7",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "pg-mem": "^3.0.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
